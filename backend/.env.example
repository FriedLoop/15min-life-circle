# 复制本文件为 .env 后填入真实值：cp .env.example .env
# .env 已被 .gitignore 忽略，不会被提交到仓库

# 百度地图「服务端 AK」
# 用途：地点检索、批量算路、地理编码等 Web 服务 API
# 获取：百度地图开放平台控制台 -> 应用管理 -> 服务端
BAIDU_SERVER_AK=your_baidu_server_ak_here

# 百度地图「浏览器端 AK」
# 用途：前端 JS API 加载地图
# 安全提示：浏览器端 AK 必然暴露在前端，务必在控制台配置 Referer 白名单，
#           仅允许 localhost / 127.0.0.1 / 你自己的域名，否则配额会被盗刷
BAIDU_BROWSER_AK=your_baidu_browser_ak_here

# 以下为可选调优参数，默认值见 app/core/config.py
# 个人开发者并发上限为 3，调高会被限流
HTTP_MAX_CONCURRENCY=3
HTTP_TIMEOUT=10
HTTP_RETRIES=2

# ---- 等时圈 ----
# 生活圈时间阈值（分钟）
WALK_MINUTES=15
# 网格间隔（米）：调大省配额，调小边界更精细（算路量按平方增长）
GRID_STEP_M=150
# 网格覆盖半径（米）
ISOCHRONE_MAX_RADIUS_M=1200
# 单次批量算路请求携带的终点数（百度未公开硬上限，50 为安全值）
ROUTEMATRIX_BATCH_SIZE=50

# ---- 盲区判定 ----
# 判定阈值（米）：可达点周边该范围内找不到设施即为盲区
BLINDSPOT_DISTANCE_M=1000
# POI 检索半径（米），必须显著大于等时圈半径，否则边缘点会被误判为盲区
POI_SEARCH_RADIUS_M=2000
# 绕行系数上限，用于直线初筛（直线距离 × 该系数 < 阈值 → 必然非盲区）
DETOUR_FACTOR=1.6
# 灰色地带精算时取最近几个候选设施做路网算路
GREY_ZONE_CANDIDATES=3

# ---- 健康度评分权重 ----
# 赛题重点关注的 3 类（菜市场/药店/小学）权重更高
CATEGORY_WEIGHT_KEY=1.5
CATEGORY_WEIGHT_NORMAL=1.0

# ---- 缓存 ----
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE=64
# 坐标量化粒度（米）：邻近坐标视为同一位置，避免拖动地图产生大量近似缓存键
CACHE_COORD_PRECISION_M=50

# 允许跨域的来源，逗号分隔；生产环境请改成具体域名
CORS_ORIGINS=*
