# 复制本文件为 .env 后填入真实值：cp .env.example .env
# .env 已被 .gitignore 忽略，不会被提交到仓库

# 百度地图「服务端 AK」
# 用途：地点检索、批量算路、地理编码等 Web 服务 API
# 获取：百度地图开放平台控制台 -> 应用管理 -> 服务端
BAIDU_SERVER_AK=your_baidu_server_ak_here

# 百度地图「浏览器端 AK」
# 用途：前端 JS API 加载地图
# 安全提示：浏览器端 AK 必然暴露在前端，务必在控制台配置 Referer 白名单，
#           仅允许 localhost / 127.0.0.1 / 你自己的域名，否则配额会被盗刷
BAIDU_BROWSER_AK=your_baidu_browser_ak_here

# 以下为可选调优参数，默认值见 app/core/config.py
# 个人开发者并发上限为 3，调高会被限流
HTTP_MAX_CONCURRENCY=3
HTTP_TIMEOUT=10
HTTP_RETRIES=2

# 允许跨域的来源，逗号分隔；生产环境请改成具体域名
CORS_ORIGINS=*
